{
  "name": "invento",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "keywords": [
    "invento",
    "full-stack",
    "backend",
    "frontend"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "homepage": "https://github.com/B2-anuragC/invento#readme",
  "bugs": {
    "url": "https://github.com/B2-anuragC/invento/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B2-anuragC/invento.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build:shared && concurrently --kill-others-on-fail \"npm run dev:api\" \"npm run dev:mobile\" \"npm run dev:admin\" \"npm run dev:shared\"",
    "dev:api": "npm --workspace @invento/api run start:dev",
    "dev:mobile": "npm --workspace @invento/mobile run start",
    "dev:admin": "npm --workspace @invento/admin run dev",
    "dev:shared": "npm --workspace @invento/shared run build -- --watch",
    "start": "npm run dev",
    "build": "npm run build:shared && npm run build:api && npm run build:mobile && npm run build:admin",
    "build:shared": "npm --workspace @invento/shared run build",
    "build:api": "npm --workspace @invento/api run build",
    "build:mobile": "npm --workspace @invento/mobile run build",
    "build:admin": "npm --workspace @invento/admin run build",
    "test": "npm run build:shared && npm run test:api && npm run test:mobile && npm run typecheck:admin && npm run lint:mobile",
    "test:api": "npm --workspace @invento/api test",
    "test:mobile": "npm --workspace @invento/mobile test",
    "typecheck": "npm run typecheck:api && npm run typecheck:mobile && npm run typecheck:admin",
    "typecheck:api": "npm --workspace @invento/api run typecheck",
    "typecheck:mobile": "npm --workspace @invento/mobile run typecheck",
    "typecheck:admin": "npm --workspace @invento/admin run typecheck",
    "lint": "npm run lint:api && npm run lint:mobile",
    "lint:api": "npm --workspace @invento/api run lint",
    "lint:mobile": "npm --workspace @invento/mobile run lint",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f backend",
    "start:backend": "npm run dev:api",
    "start:frontend": "npm run dev:mobile",
    "start:admin": "npm run dev:admin",
    "build:backend": "npm run build:api",
    "build:frontend": "npm run build:mobile",
    "test:backend": "npm run test:api",
    "test:frontend": "npm run test:mobile && npm run lint:mobile",
    "run:backend": "npm run dev:api",
    "run:frontend": "npm run dev:mobile",
    "run": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
