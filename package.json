{
  "name": "invento",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "keywords": [
    "invento",
    "full-stack",
    "backend",
    "frontend"
  ],
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared"
  ],
  "homepage": "https://github.com/B2-anuragC/invento#readme",
  "bugs": {
    "url": "https://github.com/B2-anuragC/invento/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B2-anuragC/invento.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "npm --prefix packages/shared run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm run build:shared && concurrently --kill-others-on-fail \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend run start:dev",
    "start:frontend": "npm --prefix frontend run start",
    "run": "npm run start",
    "run:backend": "npm run start:backend",
    "run:frontend": "npm run start:frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
