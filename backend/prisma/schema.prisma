generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  email                 String?
  phone                 String?
  address               String?
  membersCanViewPurchasePrice Boolean                @default(true)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 BusinessUser[]
  products              Product[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  suppliers             Supplier[]
  purchases             Purchase[]
  customers             Customer[]
  sales                 Sale[]
  payments              TransactionPayment[]

  @@map("businesses")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  businesses    BusinessUser[]
  refreshTokens RefreshToken[]
  payments      TransactionPayment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       String   @default("OWNER")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_users")
}

model Product {
  id                    String                 @id @default(cuid())
  businessId            String
  name                  String
  sku                   String
  barcode               String?
  category              String?
  unit                  String
  piecesPerUnit         Int?
  gstRate               Decimal                @default(0) @db.Decimal(5, 2)
  sellingOptions        Json                   @default("[]")
  purchasePrice         Decimal                @db.Decimal(12, 2)
  sellingPrice          Decimal                @db.Decimal(12, 2)
  minimumStock          Decimal                @db.Decimal(12, 3)
  status                ProductStatus          @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, name])
  @@index([businessId, barcode])
  @@map("products")
}

enum InventoryTransactionType {
  OPENING_STOCK
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRED
}

model Inventory {
  id         String   @id @default(cuid())
  businessId String
  productId  String   @unique
  quantity   Decimal  @db.Decimal(18, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("inventories")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  businessId      String
  productId       String
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(18, 3)
  balanceAfter    Decimal                  @db.Decimal(18, 3)
  note            String?
  createdByUserId String
  createdAt       DateTime                 @default(now())
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, productId, createdAt])
  @@map("inventory_transactions")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@index([businessId, status])
  @@index([businessId, name])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Purchase {
  id              String         @id @default(cuid())
  businessId      String
  supplierId      String
  invoiceNumber   String?
  purchaseDate    DateTime
  subtotal        Decimal       @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal?      @db.Decimal(14, 2)
  dueDate         DateTime?     @db.Date
  requestId       String?
  payments        TransactionPayment[]
  total           Decimal        @db.Decimal(14, 2)
  status          PurchaseStatus @default(COMPLETED)
  note            String?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items           PurchaseItem[]

  @@index([businessId, purchaseDate])
  @@index([businessId, supplierId])
  @@map("purchases")
  @@unique([businessId, requestId])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  productId     String
  quantity      Decimal  @db.Decimal(12, 3)
  purchasePrice Decimal  @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       Sale[]

  @@index([businessId, status])
  @@index([businessId, name])
  @@map("customers")
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Sale {
  id              String        @id @default(cuid())
  businessId      String
  customerId      String
  invoiceNumber   String?
  saleDate        DateTime
  paymentMethod   PaymentMethod
  subtotal        Decimal       @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal?      @db.Decimal(14, 2)
  dueDate         DateTime?     @db.Date
  requestId       String?
  payments        TransactionPayment[]
  total           Decimal       @db.Decimal(14, 2)
  status          SaleStatus    @default(COMPLETED)
  note            String?
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           SaleItem[]

  @@index([businessId, saleDate])
  @@index([businessId, customerId])
  @@map("sales")
  @@unique([businessId, requestId])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String?
  sellingOptionId String?
  optionName   String?
  unitsPerOption Decimal @default(1) @db.Decimal(12,3)
  sellingPrice Decimal  @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model TransactionPayment {
  id              String @id @default(cuid())
  businessId      String
  saleId          String?
  purchaseId      String?
  requestId       String
  amount          Decimal @db.Decimal(14,2)
  method          PaymentMethod
  kind            String @default("PAYMENT")
  paidAt          DateTime @default(now())
  createdByUserId String
  business        Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale            Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchase        Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([businessId, requestId])
  @@index([saleId])
  @@index([purchaseId])
  @@map("transaction_payments")
}
