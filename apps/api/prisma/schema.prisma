generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  email                 String?
  phone                 String?
  address               String?
  membersCanViewPurchasePrice Boolean                @default(true)
  invoicePrefix         String                 @default("INV")
  /// GST registration; null for an unregistered shop.
  gstin                 String?
  /// GST state code of the shop (place of supply for counter sales).
  stateCode             String?
  purchasePrefix        String                 @default("PUR")
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  roles                 BusinessRole[]
  users                 BusinessUser[]
  products              Product[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  suppliers             Supplier[]
  purchases             Purchase[]
  customers             Customer[]
  sales                 Sale[]
  payments              TransactionPayment[]
  documentCounters      DocumentCounter[]
  saleReturns           SaleReturn[]
  purchaseReturns       PurchaseReturn[]

  @@map("businesses")
}

/// Last invoice number issued per business, series (SALE or PURCHASE) and
/// Indian financial year. Incremented inside the sale/purchase transaction,
/// so a rolled-back bill uses no number.
model DocumentCounter {
  businessId    String
  series        String
  financialYear String
  lastNumber    Int
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, series, financialYear])
  @@map("document_counters")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  isPlatformAdmin Boolean @default(false)
  sessionVersion Int @default(0)
  lastLoginAt DateTime?
  lastActivityAt DateTime?
  passwordHash  String
  phone         String?
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  businesses    BusinessUser[]
  refreshTokens RefreshToken[]
  payments      TransactionPayment[]

  @@index([lastActivityAt])
  @@index([lastLoginAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       String   @default("OWNER")
  roleDefinition BusinessRole @relation(fields: [businessId, role], references: [businessId, key], onDelete: Restrict, onUpdate: Cascade)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_users")
}

model Product {
  images Json @default("[]")
  imageThumbnail String?
  imageOriginal String?
  revision Int @default(1)
  id                    String                 @id @default(cuid())
  businessId            String
  name                  String
  sku                   String
  barcode               String?
  category              String?
  unit                  String
  piecesPerUnit         Int?
  gstRate               Decimal                @default(0) @db.Decimal(5, 2)
  /// HSN code (4, 6 or 8 digits) printed on GST invoices.
  hsnCode               String?
  sellingOptions        Json                   @default("[]")
  purchasePrice         Decimal                @db.Decimal(12, 2)
  sellingPrice          Decimal                @db.Decimal(12, 2)
  minimumStock          Decimal                @db.Decimal(12, 3)
  status                ProductStatus          @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  saleReturnItems       SaleReturnItem[]
  purchaseReturnItems   PurchaseReturnItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status])
  @@index([businessId, name])
  @@index([businessId, barcode])
  @@map("products")
}

enum InventoryTransactionType {
  OPENING_STOCK
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRED
}

model Inventory {
  id         String   @id @default(cuid())
  businessId String
  productId  String   @unique
  quantity   Decimal  @db.Decimal(18, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("inventories")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  businessId      String
  productId       String
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(18, 3)
  balanceAfter    Decimal                  @db.Decimal(18, 3)
  note            String?
  createdByUserId String
  createdAt       DateTime                 @default(now())
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, productId, createdAt])
  @@map("inventory_transactions")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  categories String[] @default([])
  productIds String[] @default([])
  revision Int @default(1)
  id          String         @id @default(cuid())
  businessId  String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstin       String?
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@index([businessId, status])
  @@index([businessId, name])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Purchase {
  attachment Json?
  id              String         @id @default(cuid())
  businessId      String
  supplierId      String
  /// The supplier's own invoice number; our number is documentNumber.
  invoiceNumber   String?
  documentNumber  String?
  financialYear   String?
  documentSeq     Int?
  purchaseDate    DateTime
  subtotal        Decimal       @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  /// Whether the supplier charged GST; when false every line has tax 0.
  chargeGst       Boolean       @default(true)
  amountPaid      Decimal?      @db.Decimal(14, 2)
  dueDate         DateTime?     @db.Date
  requestId       String?
  payments        TransactionPayment[]
  total           Decimal        @db.Decimal(14, 2)
  /// Sum of the debit notes against this purchase; the net amount is total minus this.
  returnedTotal   Decimal        @default(0) @db.Decimal(14, 2)
  status          PurchaseStatus @default(COMPLETED)
  /// Set together when the purchase is cancelled; the bill keeps its number.
  cancelledAt     DateTime?
  cancelledByUserId String?
  cancelReason    String?
  note            String?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items           PurchaseItem[]
  returns         PurchaseReturn[]

  @@index([businessId, purchaseDate])
  @@index([businessId, supplierId])
  @@index([businessId, documentNumber])
  @@map("purchases")
  @@unique([businessId, requestId])
  @@unique([businessId, financialYear, documentSeq])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  productId     String
  quantity      Decimal  @db.Decimal(12, 3)
  purchasePrice Decimal  @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems   PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  imageOriginal String?
  imageThumbnail String?
  revision Int @default(1)
  id          String         @id @default(cuid())
  businessId  String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstin       String?
  /// TRUE on the shop's built-in walk-in customer, NULL on every other one.
  isWalkIn    Boolean?
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       Sale[]

  @@unique([businessId, isWalkIn])
  @@index([businessId, status])
  @@index([businessId, name])
  @@map("customers")
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Sale {
  referenceImage  String?
  id              String        @id @default(cuid())
  businessId      String
  customerId      String
  /// Free-text reference typed by the user; the system number is documentNumber.
  invoiceNumber   String?
  documentNumber  String?
  financialYear   String?
  documentSeq     Int?
  /// GST details copied when the sale is created, so the invoice never changes.
  sellerGstin     String?
  sellerStateCode String?
  buyerGstin      String?
  placeOfSupply   String?
  /// INTRA_STATE (CGST + SGST), INTER_STATE (IGST) or UNREGISTERED (bill of supply); null on older sales.
  taxType         String?
  /// Whether the sale charged GST; when false every line has tax 0 and it prints as a bill of supply.
  chargeGst       Boolean       @default(true)
  saleDate        DateTime
  paymentMethod   PaymentMethod
  subtotal        Decimal       @db.Decimal(14, 2)
  /// Bill-level discount; split across the lines, it lowers their taxable value.
  discountTotal   Decimal       @default(0) @db.Decimal(14, 2)
  /// The percentage entered, when the discount was given as one.
  discountPercent Decimal?      @db.Decimal(5, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal?      @db.Decimal(14, 2)
  dueDate         DateTime?     @db.Date
  requestId       String?
  payments        TransactionPayment[]
  total           Decimal       @db.Decimal(14, 2)
  /// Sum of the credit notes against this sale; the net amount is total minus this.
  returnedTotal   Decimal       @default(0) @db.Decimal(14, 2)
  status          SaleStatus    @default(COMPLETED)
  /// Set together when the sale is cancelled; the bill keeps its number.
  cancelledAt     DateTime?
  cancelledByUserId String?
  cancelReason    String?
  note            String?
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           SaleItem[]
  returns         SaleReturn[]

  @@index([businessId, saleDate])
  @@index([businessId, customerId])
  @@index([businessId, documentNumber])
  @@map("sales")
  @@unique([businessId, requestId])
  @@unique([businessId, financialYear, documentSeq])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String?
  sellingOptionId String?
  optionName   String?
  unitsPerOption Decimal @default(1) @db.Decimal(12,3)
  sellingPrice Decimal  @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal  @db.Decimal(14, 2)
  /// This line's share of the bill discount; GST is charged on lineTotal minus it.
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  /// The product's HSN code when the sale was made.
  hsnCode      String?
  /// Stock the line took, in ledger units (pieces for grouped products); a return puts back its share.
  stockQuantity Decimal? @db.Decimal(18, 3)
  createdAt    DateTime @default(now())
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems  SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

/// A sales return: a credit note numbered in its own series (CN/2026-27/0001).
model SaleReturn {
  id              String   @id @default(cuid())
  businessId      String
  saleId          String
  documentNumber  String
  financialYear   String
  documentSeq     Int
  returnDate      DateTime @default(now())
  subtotal        Decimal  @db.Decimal(14, 2)
  discountTotal   Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal  @default(0) @db.Decimal(14, 2)
  total           Decimal  @db.Decimal(14, 2)
  /// Paid back to the customer; the rest of the total reduced what they owed.
  refundAmount    Decimal  @default(0) @db.Decimal(14, 2)
  refundMethod    PaymentMethod?
  reason          String?
  requestId       String
  createdByUserId String
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items           SaleReturnItem[]

  @@unique([businessId, requestId])
  @@unique([businessId, financialYear, documentSeq])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id             String     @id @default(cuid())
  returnId       String
  saleItemId     String
  productId      String
  quantity       Decimal    @db.Decimal(12, 3)
  stockQuantity  Decimal    @db.Decimal(18, 3)
  lineTotal      Decimal    @db.Decimal(14, 2)
  discountAmount Decimal    @default(0) @db.Decimal(14, 2)
  gstRate        Decimal    @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(14, 2)
  saleReturn     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem       SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([returnId, saleItemId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

/// A purchase return: a debit note numbered in its own series (DN/2026-27/0001).
model PurchaseReturn {
  id              String   @id @default(cuid())
  businessId      String
  purchaseId      String
  documentNumber  String
  financialYear   String
  documentSeq     Int
  returnDate      DateTime @default(now())
  subtotal        Decimal  @db.Decimal(14, 2)
  taxTotal        Decimal  @default(0) @db.Decimal(14, 2)
  total           Decimal  @db.Decimal(14, 2)
  /// Paid back by the supplier; the rest of the total reduced what the shop owed.
  refundAmount    Decimal  @default(0) @db.Decimal(14, 2)
  refundMethod    PaymentMethod?
  reason          String?
  requestId       String
  createdByUserId String
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  items           PurchaseReturnItem[]

  @@unique([businessId, requestId])
  @@unique([businessId, financialYear, documentSeq])
  @@index([purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  purchaseItemId String
  productId      String
  quantity       Decimal        @db.Decimal(12, 3)
  lineTotal      Decimal        @db.Decimal(14, 2)
  gstRate        Decimal        @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(14, 2)
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([returnId, purchaseItemId])
  @@index([purchaseItemId])
  @@map("purchase_return_items")
}

model TransactionPayment {
  id              String @id @default(cuid())
  businessId      String
  saleId          String?
  purchaseId      String?
  requestId       String
  amount          Decimal @db.Decimal(14,2)
  method          PaymentMethod
  kind            String @default("PAYMENT")
  paidAt          DateTime @default(now())
  createdByUserId String
  business        Business @relation(fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale            Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchase        Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([businessId, requestId])
  @@index([saleId])
  @@index([purchaseId])
  @@map("transaction_payments")
}

model SyncOperation {
  businessId String
  operationId String
  userId String
  payloadHash String
  result Json
  createdAt DateTime @default(now())
  @@id([businessId, operationId])
  @@map("sync_operations")
}

// Intentionally independent of target FKs: audit history survives target removal.
model PlatformAuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  targetType String
  targetId String
  businessId String?
  reason String
  previous Json
  next Json
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@index([targetType, targetId, createdAt])
  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@map("platform_audit_logs")
}

model BusinessRole {
  businessId String
  key String
  name String
  permissions String[]
  isSystem Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members BusinessUser[]
  @@id([businessId, key])
  @@map("business_roles")
}
