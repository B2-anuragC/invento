NODE_ENV=development
PORT=3000
APP_API_PREFIX=api
DATABASE_URL="postgresql://invento:invento@localhost:5432/invento_dev?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"

# Uploads are physical files; Docker overrides this with /app/uploads (persistent volume).
UPLOAD_STORAGE_PATH=./uploads
# Optional S3 mirror. With no bucket, files remain local. Default AWS credential
# providers (IAM roles, shared credentials) also work; static keys are optional.
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=invento
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=


# BullMQ uses DATABASE_URL and manages its tables in the invento_queue schema.
